# Copy to .env.local and fill in. Never commit real keys.

# "sample" (default) returns curated lessons without calling the AI.
# "live" calls Claude and needs ANTHROPIC_API_KEY.
GENERATION_MODE=sample

# Server-side only. Create a key at https://platform.claude.com and set a spend limit there.
ANTHROPIC_API_KEY=

# Optional tuning
# Standard generations (all plans) and "high quality" ones (Pro, counted as two).
# Models you can use (price per million input / output tokens; cost per lesson measured or estimated):
#   claude-sonnet-5-5  $2 / $10    ~$0.06-0.08, 30-45 s (measured). Recommended for standard lessons.
#   claude-opus-5-5    $4 / $20    ~$0.11-0.15 (estimated), slower. Recommended for "high quality".
#   claude-haiku-5-5   $0.10/$0.50 ~$0.005 (estimated), fastest. Untested here, and web research does not
#                                  work with it (its search tool version isn't supported); no refusal fallback.
#   claude-fable-5-1   $10 / $50   ~$0.30 (estimated), slowest. Most capable, but more than these lessons need.
# Older models (claude-sonnet-5, claude-opus-5, claude-haiku-4-5) work but cost the same or more for less.
# See "Choosing models" in the README.
GENERATION_MODEL_STANDARD=claude-sonnet-5-5
GENERATION_MODEL_HIGH=claude-opus-5-5
# How much the model thinks: low, medium, high, xhigh or max. Keep "medium": in an October 2026 test, "low"
# saved only ~4% and made small mistakes; higher levels cost more without a measured benefit.
GENERATION_EFFORT=medium
# Pro users can ask for web-researched lessons (Claude's web search, about $0.01 per search, max 5 per lesson).
GENERATION_WEB_RESEARCH=true
# Live generations per visitor per hour, and across all visitors per day.
GENERATION_HOURLY_LIMIT=5
GENERATION_DAILY_CAP=50

# --- Accounts ---
# Without DATABASE_URL, an embedded Postgres (PGlite) in .data/ is used and migrated automatically.
# With it, run `npm run db:migrate` after each deploy that adds migrations.
DATABASE_URL=
# Leave empty while developing: Better Auth then uses a built-in development secret, and sign-in links
# go to the development mailbox as usual. Required in production, where the app refuses to start
# without it: a long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://lessons.example.com
BETTER_AUTH_URL=http://localhost:3000
# Optional: enables "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email: leave empty while developing. Sign-in emails are then kept in .data/mailbox.jsonl and shown at
# http://localhost:3000/dev/mailbox (development only). In production set EMAIL_TRANSPORT=resend with a
# Resend API key and a sender on a domain verified in Resend, e.g. "Lesson Builder <sign-in@example.com>".
EMAIL_TRANSPORT=
RESEND_API_KEY=
EMAIL_FROM=
# "false" hides email sign-in and refuses its endpoint, e.g. on a deployment without a verified email domain.
EMAIL_SIGN_IN=

# Shown on /privacy as the address for questions about data. Without it, the page says to ask whoever invited you.
CONTACT_EMAIL=
# Server errors are kept for 30 days at /admin/errors. Optionally also post them to a Slack or Discord
# incoming webhook (at most 10 alerts an hour).
ERROR_ALERT_WEBHOOK_URL=

# Development only (ignored in production): put every account on a plan, e.g. "pro", to try paid
# features without Stripe.
DEV_PLAN_OVERRIDE=

# Demo sign-in ("Try the demo" on the sign-in page): a throwaway account with no email. Off unless "true".
# With access codes set (comma-separated), visitors need one of them; empty means anyone can start a demo.
DEMO_SIGN_IN=
DEMO_ACCESS_CODES=

# Site operators (comma-separated emails) who can open the generation log at /admin/generations.
# Left empty, every signed-in user can see it while developing and nobody can in production.
ADMIN_EMAILS=

# --- Billing (Stripe) ---
# Billing stays off until the secret key and at least one Pro price are set; everyone is on Free.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint's signing secret in the dashboard.
# Endpoint: /api/billing/webhook. Events: checkout.session.completed, customer.subscription.*
STRIPE_WEBHOOK_SECRET=
# Recurring price ids for Pro (Stripe dashboard > Product catalog).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# "true" lets Stripe Tax calculate VAT/sales tax at checkout (set up Stripe Tax first).
STRIPE_AUTOMATIC_TAX=false
