# Copy to .env.local and fill in. Never commit real keys.

# "sample" (default) returns curated lessons without calling the AI.
# "live" calls Claude and needs ANTHROPIC_API_KEY.
GENERATION_MODE=sample

# Server-side only. Create a key at https://platform.claude.com and set a spend limit there.
ANTHROPIC_API_KEY=

# Optional tuning
GENERATION_MODEL=claude-opus-5-5
GENERATION_EFFORT=medium
# Live generations per visitor per hour, and across all visitors per day.
GENERATION_HOURLY_LIMIT=5
GENERATION_DAILY_CAP=50
