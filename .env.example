# Copy to .env.local and fill in. Never commit real keys.

# "sample" (default) returns curated lessons without calling the AI.
# "live" calls Claude and needs ANTHROPIC_API_KEY.
GENERATION_MODE=sample

# Server-side only. Create a key at https://platform.claude.com and set a spend limit there.
ANTHROPIC_API_KEY=

# Optional tuning
# Standard generations (all plans) and "high quality" ones (Pro, counted as two).
GENERATION_MODEL_STANDARD=claude-sonnet-5-5
GENERATION_MODEL_HIGH=claude-opus-5-5
GENERATION_EFFORT=medium
# Pro users can ask for web-researched lessons (Claude's web search, about $0.01 per search, max 5 per lesson).
GENERATION_WEB_RESEARCH=true
# Live generations per visitor per hour, and across all visitors per day.
GENERATION_HOURLY_LIMIT=5
GENERATION_DAILY_CAP=50

# --- Accounts ---
# Without DATABASE_URL, an embedded Postgres (PGlite) in .data/ is used and migrated automatically.
# With it, run `npm run db:migrate` after each deploy that adds migrations.
DATABASE_URL=
# Required in production: a long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://lessons.example.com
BETTER_AUTH_URL=http://localhost:3000
# Optional: enables "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email: "file" writes sign-in emails to .data/mailbox.jsonl (default outside production).
# Production needs a real provider (planned); until then sign-in emails can't be sent there.
EMAIL_TRANSPORT=

# --- Billing (Stripe) ---
# Billing stays off until the secret key and at least one Pro price are set; everyone is on Free.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint's signing secret in the dashboard.
# Endpoint: /api/billing/webhook. Events: checkout.session.completed, customer.subscription.*
STRIPE_WEBHOOK_SECRET=
# Recurring price ids for Pro (Stripe dashboard > Product catalog).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# "true" lets Stripe Tax calculate VAT/sales tax at checkout (set up Stripe Tax first).
STRIPE_AUTOMATIC_TAX=false
